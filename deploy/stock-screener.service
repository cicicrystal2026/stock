[Unit]
Description=Stock Screener (优选决策台) Flask App
After=network.target

[Service]
User=root
WorkingDirectory=/opt/stock-screener
Environment=PORT=8000
Environment=STOCK_APP_PASSWORD=__PASSWORD__
ExecStart=/opt/stock-screener/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 --timeout 120 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
